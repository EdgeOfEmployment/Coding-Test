#DP
def solution(board):
    rows = len(board)
    cols = len(board[0])
    
    max_size = 0
    
    for i in range(rows):
        if board[i][0] == 1:
            max_size = 1
    
    for j in range(cols):
        if board[0][j] == 1:
            max_size = 1
        
    for i in range(1, rows):
        for j in range(1, cols):
            
            if board[i][j] == 1:
                board[i][j] = min(
                board[i-1][j-1],
                board[i-1][j],
                board[i][j-1]) +1
                
                max_size = max(max_size, board[i][j])
                
    return max_size*max_size
